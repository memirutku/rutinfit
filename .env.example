# ==========================================
# RutinFit Desktop - Environment Variables
# ==========================================

# Local SQLite Database
# In desktop production, storage-paths.ts automatically maps to OS AppData (~/Library/Application Support/RutinFit/rutinfit.db)
DATABASE_URL="file:./prisma/dev.db"

# Local AI Providers (Ollama / LM Studio)
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"

# Open Food Facts API User-Agent Identification
# Format: AppName/Version (ContactURL-or-Email)
OPENFOODFACTS_USER_AGENT="RutinFit-Desktop/0.1.0 (https://github.com/memirutku/rutinfit)"

# Optional Cloud AI API Key (Disabled by default, user-configured)
OPENAI_API_KEY=""
