// Prisma 7: bağlantı adresi şemada değil; CLI için prisma.config.ts, uygulama için
// src/lib/db/client.ts (better-sqlite3 sürücü adaptörü).
datasource db {
  provider = "sqlite"
}

// Rust'sız istemci; src/generated/prisma'ya üretilir (git'e girmez, `pnpm install` sonrası
// postinstall ve `prisma generate` üretir).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // Proje CommonJS (package.json'da "type" yok); tsx ve Vitest ile uyumlu çıktı.
  moduleFormat = "cjs"
}

// Prisma 7 `Prisma.dmmf`'i dışa vermiyor; yedekleme servisi için alan bilgisi (bkz. dosya başı).
generator datamodel {
  provider = "node ./prisma/generators/datamodel.mjs"
  output   = "../src/generated/datamodel.ts"
}

model UserProfile {
  id              String   @id @default("default-user")
  heightCm        Float    @default(181)
  age             Int      @default(25)
  sex             String   @default("male")
  currentWeightKg Float    @default(112)
  calorieTarget   Int      @default(2080)
  calorieCeiling  Int      @default(2100)
  proteinTargetG  Int      @default(165)
  fatTargetG      Int      @default(60)
  carbTargetG     Int      @default(220)
  wakeTime        String   @default("06:00")
  workdayHomeTime String   @default("19:30")
  isOnboarded     Boolean  @default(false)
  hideNumbers     Boolean  @default(false) // F56: kalori ve makro sayılarını gizle
  // F09: kurulum sihirbazı girdileri
  activityLevel     String @default("light") // sedentary, light, moderate, active, very_active
  goalType          String @default("lose") // lose, maintain, gain
  goalRateKgPerWeek Float  @default(0.5)
  targetWeightKg    Float?
  waterTargetMl     Int    @default(2500) // F13: günlük sıvı hedefi
  householdSize     Int    @default(1) // F31: alışveriş listesi kaç kişilik
  coachNotes        String? // F52: alerji, sakatlık, ekipman, çalışma düzeni (koça bilgi)
  // F76: Ramazan modu (il bazlı, internetsiz imsak/iftar) · F14: aralıklı oruç hedefi
  ramadanMode        Boolean @default(false)
  ramadanProvince    String  @default("İstanbul")
  ramadanImsakAdjust Int     @default(0) // dakika
  ramadanIftarAdjust Int     @default(0) // dakika
  fastingTargetHours Int? // null: zamanlayıcı kapalı
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FoodItem {
  id         String   @id @default(cuid())
  name       String
  category   String   @default("Genel")
  brand      String?
  barcode    String?  @unique
  basisGrams Float    @default(100)
  calories   Float
  proteinG   Float
  carbsG     Float
  fatG       Float
  source     String   @default("Katalog")
  confidence String   @default("Yüksek") // Yüksek, Tahmini, Kullanıcı
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recipeIngredients RecipeIngredient[]
  foodLogs          FoodLog[]
  savedMealItems    SavedMealItem[]
  measures          FoodMeasure[]
}

/// F73: Kullanıcının kendi tartımıyla eklediği ev ölçüsü (yerleşik ölçüler kodda: src/lib/measures.ts).
model FoodMeasure {
  id         String @id @default(cuid())
  foodItemId String
  name       String // yemek kaşığı, su bardağı, kase, dilim, adet...
  grams      Float

  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@unique([foodItemId, name])
}

model Recipe {
  id           String   @id @default(cuid())
  name         String
  instructions String?
  prepMinutes  Int      @default(15)
  servings     Int      @default(1)
  tags         String? // JSON string: ["yüksek protein", "hızlı"]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredients    RecipeIngredient[]
  plannedMeals   PlannedMeal[]
  foodLogs       FoodLog[]
  savedMealItems SavedMealItem[]
}

model RecipeIngredient {
  id         String @id @default(cuid())
  recipeId   String
  foodItemId String
  grams      Float

  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id])

  @@index([recipeId])
  @@index([foodItemId])
}

model MealPlan {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals PlannedMeal[]
}

model PlannedMeal {
  id          String  @id @default(cuid())
  mealPlanId  String
  mealType    String // breakfast, lunch, workSnack, dinner
  recipeId    String?
  customName  String?
  plannedTime String?
  servings    Float   @default(1)
  isCompleted Boolean @default(false)
  adherence   String? // F78: done (uygulandı), partial (kısmen), skipped (atlandı)

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe   Recipe?  @relation(fields: [recipeId], references: [id])

  @@index([mealPlanId])
  @@index([recipeId])
}

model FoodLog {
  id               String   @id @default(cuid())
  date             String // YYYY-MM-DD
  time             String // HH:mm
  mealType         String // breakfast, lunch, workSnack, dinner, extra
  foodItemId       String?
  recipeId         String?
  name             String
  grams            Float
  caloriesSnapshot Float
  proteinSnapshot  Float
  carbsSnapshot    Float
  fatSnapshot      Float
  createdAt        DateTime @default(now())

  foodItem FoodItem? @relation(fields: [foodItemId], references: [id])
  recipe   Recipe?   @relation(fields: [recipeId], references: [id])
  drinkLog DrinkLog?

  @@index([date, createdAt])
  @@index([foodItemId])
  @@index([recipeId])
}

/// F01: Kayıtlı öğün (ör. "her sabahki kahvaltım"). Kalemler eklenirken katalog gıdası
/// güncel değeriyle, serbest kalem kayıtlı değeriyle hesaplanır.
model SavedMeal {
  id        String   @id @default(cuid())
  name      String
  mealType  String? // varsayılan öğün
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SavedMealItem[]
}

model SavedMealItem {
  id               String  @id @default(cuid())
  savedMealId      String
  foodItemId       String?
  recipeId         String?
  name             String
  grams            Float
  caloriesSnapshot Float
  proteinSnapshot  Float
  carbsSnapshot    Float
  fatSnapshot      Float
  orderIndex       Int     @default(0)

  savedMeal SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  foodItem  FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  recipe    Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([savedMealId])
  @@index([foodItemId])
  @@index([recipeId])
}

/// F13: Su, çay, kahve ve alkol. Kalorili içeceğin enerjisi bağlı FoodLog kaydındadır.
model DrinkLog {
  id         String   @id @default(cuid())
  date       String // YYYY-MM-DD
  time       String   @default("12:00") // HH:mm
  kind       String // water, tea, coffee, alcohol, other
  name       String
  ml         Float
  caffeineMg Float    @default(0)
  alcoholG   Float    @default(0)
  kcal       Float    @default(0)
  foodLogId  String?  @unique
  createdAt  DateTime @default(now())

  foodLog FoodLog? @relation(fields: [foodLogId], references: [id], onDelete: SetNull)

  @@index([date])
}

/// F25: Kullanıcının eklediği egzersiz (yerleşik kütüphane kodda: src/lib/exercise-library.ts).
model CustomExercise {
  id        String   @id @default(cuid())
  name      String   @unique
  nameTr    String?
  primary   String // kas kimliği (src/lib/muscles.ts)
  secondary String   @default("[]") // JSON dizi
  equipment String
  cues      String   @default("[]") // JSON dizi
  createdAt DateTime @default(now())
}

model WorkoutTemplate {
  id                    String  @id @default(cuid())
  name                  String // Ağırlık A, Kolay Koşu, vb.
  type                  String // strength, easy_run, rest
  dayOfWeek             Int // 1: Pzt, 2: Sal, ... 7: Paz
  targetDurationMinutes Int     @default(40)
  notes                 String?

  exercises WorkoutExercise[]
  sessions  WorkoutSession[]
}

model WorkoutExercise {
  id           String @id @default(cuid())
  templateId   String
  exerciseName String
  targetSets   Int    @default(3)
  repMin       Int    @default(8)
  repMax       Int    @default(12)
  restSeconds  Int    @default(90)
  orderIndex   Int    @default(0)
  incrementKg  Float  @default(2.5) // F21: ilerlemede eklenecek ağırlık

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model WorkoutSession {
  id              String   @id @default(cuid())
  date            String // YYYY-MM-DD
  templateId      String?
  name            String
  durationMinutes Int      @default(0)
  rpe             Int? // 1 - 10
  notes           String?
  completed       Boolean  @default(true)
  createdAt       DateTime @default(now())

  template WorkoutTemplate? @relation(fields: [templateId], references: [id])
  setLogs  SetLog[]

  @@index([date])
  @@index([templateId])
}

model SetLog {
  id               String  @id @default(cuid())
  workoutSessionId String
  exerciseName     String
  setNumber        Int
  weightKg         Float
  reps             Int
  rpe              Float? // set başına algılanan zorluk, 1–10, yarım puanlı (RIR = 10 - RPE)
  setType          String  @default("normal") // F19: normal, warmup, drop, failure
  isTargetMet      Boolean @default(false)

  session WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@index([workoutSessionId])
}

/// F27: Koşu, yürüyüş, bisiklet, yüzme ve diğer kardiyo (elle kayıt).
model CardioLog {
  id            String   @id @default(cuid())
  date          String // YYYY-MM-DD
  kind          String // run, walk, cycle, swim, other
  durationMin   Float
  distanceKm    Float?
  avgHr         Int?
  rpe           Float?
  kcal          Float?
  kcalEstimated Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())

  @@index([date])
}

model WeightLog {
  id             String   @id @default(cuid())
  date           String   @unique // YYYY-MM-DD
  weightKg       Float
  conditionsNote String?
  createdAt      DateTime @default(now())
}

/// F16: Vücut ölçüleri ve sağlık metrikleri (her alan isteğe bağlı; gün başına bir kayıt).
model BodyMeasurement {
  id             String   @id @default(cuid())
  date           String   @unique // YYYY-MM-DD
  waistCm        Float?
  hipCm          Float?
  chestCm        Float?
  armCm          Float?
  thighCm        Float?
  neckCm         Float?
  bodyFatPercent Float?
  restingHr      Int?
  systolic       Int?
  diastolic      Int?
  notes          String?
  createdAt      DateTime @default(now())
}

/// F16: İlerleme fotoğrafı. Dosya veri klasöründe (progress-photos) durur; yedek dosyasına girmez.
model ProgressPhoto {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD
  pose      String // front, side, back
  fileName  String   @unique
  mimeType  String
  sizeBytes Int
  notes     String?
  createdAt DateTime @default(now())

  @@index([date])
}

model DailyWellbeing {
  id           String   @id @default(cuid())
  date         String   @unique // YYYY-MM-DD
  energy1to5   Int      @default(3)
  hunger1to5   Int      @default(3)
  sleepMinutes Int      @default(420) // 7 saat
  stress1to5   Int      @default(3)
  soreness1to5 Int? // F51: kas ağrısı (1 yok, 5 çok)
  mood1to5     Int? // F51: ruh hâli
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// F15: Kullanıcının takviye listesi. Günlük kayıtlar ada göre SupplementLog'da tutulur.
model Supplement {
  id         String   @id @default(cuid())
  name       String   @unique
  doseAmount Float
  doseUnit   String   @default("g") // g, mg, mcg, IU, kapsül, tablet, damla, ml, ölçek
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// F14: Aralıklı oruç kayıtları.
model FastingSession {
  id          String    @id @default(cuid())
  startedAt   DateTime
  endedAt     DateTime?
  targetHours Int
  createdAt   DateTime  @default(now())
}

/// F83: Uygulama açıkken gösterilen hatırlatmalar (öğün, su, tartı, takviye, antrenman, serbest).
model Reminder {
  id           String   @id @default(cuid())
  kind         String // meal, water, weigh, supplement, workout, custom
  title        String
  time         String // HH:MM
  days         String   @default("1234567") // ISO hafta günleri (1 = Pazartesi)
  enabled      Boolean  @default(true)
  mealType     String?
  supplementId String?
  lastFiredOn  String? // YYYY-MM-DD: aynı gün ikinci kez gösterilmez
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SupplementLog {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD
  name      String   @default("Kreatin Monohidrat")
  doseGrams Float    @default(5.0) // doz miktarı (birimi doseUnit)
  doseUnit  String   @default("g") // F15
  taken     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([date, name])
}

model ShoppingListItem {
  id        String   @id @default(cuid())
  weekStart String // YYYY-MM-DD
  category  String // Manav, Kasap/Balık, Süt Ürünleri, Kuru Gıda/Bakliyat, Diğer
  name      String
  amount    Float
  unit      String   @default("g")
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())

  // Aynı hafta için aynı kalem iki kez oluşamaz (eşzamanlı yenilemeye karşı).
  @@unique([weekStart, name])
}

model AISettings {
  id               String    @id @default("default-ai")
  providerType     String    @default("ollama") // ollama, lmstudio, openai
  baseUrl          String    @default("http://127.0.0.1:11434/v1")
  modelName        String    @default("llama3.2")
  connectionStatus String    @default("untested") // connected, failed, untested
  lastTestedAt     DateTime?
  coachEnabled     Boolean   @default(true) // F58: koçu aç/kapa
  tone             String    @default("supportive") // F58: supportive, direct, brief
}

model AIConversation {
  id        String   @id @default(cuid())
  title     String   @default("Yeni Sohbet")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIMessage[]
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user, assistant, system
  content        String
  fileIds        String? // JSON string array of UploadedFile ids: ["cuid1", "cuid2"]
  draftId        String? // Associated ActionDraft id if any
  actionProposal String? // JSON string containing action proposal preview metadata
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  draft        ActionDraft?   @relation(fields: [draftId], references: [id])

  @@index([conversationId, createdAt])
  @@index([draftId])
}

model UploadedFile {
  id             String    @id @default(cuid())
  originalName   String
  mimeType       String
  sizeBytes      Int
  hash           String    @unique // SHA-256 for deduplication
  storagePath    String
  status         String    @default("uploaded") // uploaded, parsing, needs_review, ready_to_apply, applied, failed
  parseErrors    String? // JSON error logs or messages
  retentionUntil DateTime?
  createdAt      DateTime  @default(now())

  artifacts ExtractedArtifact[]
}

model ExtractedArtifact {
  id             String   @id @default(cuid())
  fileId         String
  normalizedType String // meal_plan, workout_plan, weight_logs, recipe, unstructured
  structuredData String // JSON string of normalized payload
  confidence     String   @default("medium") // high, medium, low
  uncertainties  String? // JSON string of ambiguous fields/warnings
  sourceSummary  String?
  createdAt      DateTime @default(now())

  file UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

model ActionDraft {
  id                String   @id @default(cuid())
  draftType         String // meal_plan, food_log, recipe, nutrition_targets, workout_session, weight_wellbeing, bulk_import
  proposedChanges   String // JSON string of proposed payload and diff
  impactSummary     String // Plain-text impact summary (macros, calories, shopping diff)
  status            String   @default("pending") // pending, approved, applied, rejected
  approvalTokenHash String   @unique // SHA-256 hash of approval token
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  messages AIMessage[]

  @@index([status, expiresAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actionType String // APPLY_DRAFT, REJECT_DRAFT, FILE_UPLOAD, FILE_PARSE, MANUAL_OVERRIDE
  entityType String // MealPlan, FoodLog, Recipe, UploadedFile, ActionDraft, etc.
  entityId   String?
  status     String // SUCCESS, FAILED, REVERTED
  details    String? // JSON string containing payload/diff or error
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model PantryItem {
  id         String   @id @default(cuid())
  name       String
  amount     Float // e.g. 500
  unit       String   @default("g") // g, ml, adet
  category   String   @default("Genel") // Kuru Gıda, Süt Ürünleri, Kasap/Balık, Manav, vb.
  expiryDate String? // YYYY-MM-DD
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([name])
}

/// F61: Seçilen klasöre zamanlanmış otomatik yedek. Makineye özgüdür; yedeğe girmez.
model AutoBackupSettings {
  id          String    @id @default("default")
  enabled     Boolean   @default(false)
  folderPath  String?
  frequency   String    @default("daily") // daily, weekly
  keepCount   Int       @default(10)
  lastRunAt   DateTime?
  lastStatus  String? // ok, error
  lastMessage String?
  lastFile    String?
  updatedAt   DateTime  @updatedAt
}

/// F49: Haftalık değerlendirme. Metrikler kodda hesaplanır; özeti model (ya da kural) yazar.
model WeeklyCheckin {
  id          String   @id @default(cuid())
  weekStart   String   @unique // Pazartesi
  metrics     String // JSON
  summary     String
  aiGenerated Boolean  @default(false)
  suggestion  String? // JSON: tek öneri
  draftId     String? // hedef değişikliği önerisinin onay taslağı
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OpenFoodFactsCache {
  id        String   @id @default(cuid())
  queryKey  String   @unique // e.g. barcode:3017620422003 or search:yulaf
  payload   String // JSON string of normalized search/barcode result
  expiresAt DateTime
  createdAt DateTime @default(now())
}
