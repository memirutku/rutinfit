{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RutinFit",
  "version": "0.1.0",
  "identifier": "com.rutinfit.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3005",
    "beforeDevCommand": "pnpm dev -p 3005",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "RutinFit — Kişisel Fitness & Beslenme Asistanı",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
