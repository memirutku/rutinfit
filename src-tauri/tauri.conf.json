{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RutinFit",
  "version": "0.1.0",
  "identifier": "com.rutinfit.desktop",
  "build": {
    "frontendDist": "splash",
    "devUrl": "http://127.0.0.1:3005",
    "beforeDevCommand": "pnpm dev -p 3005",
    "beforeBuildCommand": "pnpm build && node scripts/prepare-desktop.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/server/": "server/"
    },
    "category": "HealthcareAndFitness",
    "shortDescription": "Gizlilik odaklı kişisel fitness ve beslenme asistanı",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
