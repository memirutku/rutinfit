<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime istisnaları. Tauri bu dosyayı hem ana ikiliye hem gömülü Node'a
  (Contents/MacOS/node) uygular; ikisi için ayrı dosya desteği yok.

  Yalnız allow-jit: Node'un V8 motoru JIT için MAP_JIT bellek ister. Ölçüldü (arm64, Node 22.23.3):
    - istisnasız          → Node açılışta çöküyor (SIGTRAP, çıkış 133)
    - yalnız allow-jit    → JIT, WebAssembly, Prisma motoru ve sharp çalışıyor
  allow-unsigned-executable-memory, disable-library-validation ve get-task-allow BİLEREK yok:
  paketteki tüm native modüller aynı Developer ID ile imzalanır (scripts/prepare-desktop.mjs),
  get-task-allow ise notarization'ı reddettirir. x64 aynı kontrolü release iş akışındaki
  duman testinde (scripts/verify-desktop.mjs) Intel makinede geçer.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
